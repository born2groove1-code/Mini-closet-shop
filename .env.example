# ─────────────────────────────────────────────────────────────────────────────
# Mini Closet by Arti Chandra — environment variables
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (or "Connect" → App Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public "anon" key (newer projects call it the "publishable" key — either works here)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
# The app does not need it at runtime (all requests run as the signed-in user under
# Row-Level Security). Keep it only for trusted server jobs / future payment webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site (used for metadata, structured data and e-mail redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Boutique WhatsApp number. 10-digit Indian mobile or full international digits.
# Examples: 9876543210  or  919876543210. Leave empty to use the number in src/lib/store-config.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=
